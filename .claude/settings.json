{
  "model": "sonnet",
  "env": { "MAX_THINKING_TOKENS": "0" },
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/dist/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs npx prettier --write"
          }
        ]
      }
    ]
  }
}